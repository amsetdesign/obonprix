# Supabase > Project Settings > API (ou bouton « Connect »)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète (service_role) : création des comptes de l'équipe. Ne jamais la partager.
SUPABASE_SERVICE_ROLE_KEY=
# Notifications de commandes (web push) : clés générées avec web-push, secret aléatoire partagé avec la base
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NOTIFY_SECRET=
